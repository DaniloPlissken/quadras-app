# Configuração do Banco de Dados (Supabase / PostgreSQL)
# Conexão via Connection Pooler (Porta 6543 para execução no Next.js)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão Direta (Porta 5432 para migrations do Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth - Autenticação
NEXTAUTH_SECRET="chave-secreta-aleatoria-para-jwt"
NEXTAUTH_URL="http://localhost:3000"
