generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReservaStatus {
  CONFIRMADA
  CANCELADA_ADMIN
  CONCLUIDA
}

model User {
  id       String    @id          // CPF como PK (sem formatação)
  name     String
  email    String    @unique
  password String
  role     Role      @default(USER)
  reservas Reserva[]
}

model Modalidade {
  id      String   @id @default(cuid())
  nome    String   @unique
  quadras Quadra[]
}

model Quadra {
  id           String     @id @default(cuid())
  nome         String
  ativa        Boolean    @default(true)
  modalidadeId String
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id])
  reservas     Reserva[]
  agendas      Agenda[]

  @@unique([nome, modalidadeId])
}

model Reserva {
  id       String        @id @default(cuid())
  userId   String
  quadraId String
  timeId   String?
  data     DateTime
  slot     String
  status   ReservaStatus @default(CONFIRMADA)
  quadra   Quadra        @relation(fields: [quadraId], references: [id])
  user     User          @relation(fields: [userId], references: [id])
  time     Time?         @relation(fields: [timeId], references: [id])

  @@unique([data, slot, quadraId])
  @@index([quadraId, data])
}

model Time {
  id           String             @id @default(cuid())
  nome         String             @unique
  responsaveis ResponsavelTime[]
  reservas     Reserva[]
  createdAt    DateTime           @default(now())
}

model ResponsavelTime {
  id                    String   @id @default(cuid())
  cpf                   String
  nome                  String
  telefone              String
  comprovanteResidencia Boolean  @default(false)
  urlComprovante        String?
  antecedentesCriminais Boolean  @default(false)
  urlAntecedentes       String?
  apto                  Boolean  @default(false)
  timeId                String
  time                  Time     @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@unique([cpf, timeId])
}

model Agenda {
  id       String   @id @default(cuid())
  data     DateTime
  quadraId String
  quadra   Quadra   @relation(fields: [quadraId], references: [id])
  horarios String[]

  @@unique([data, quadraId])
  @@index([quadraId, data])
}
